# Secrets — the guard hook blocks reads, this keeps them out of history.
.env
.env.*
!.env.example
!.env.sample
*.pem
credentials.json
service-account*.json

# Dependencies and build output
node_modules/
dist/
build/
.next/
.turbo/
coverage/

# Personal Claude Code overrides
.claude/settings.local.json

# OS noise
.DS_Store
Thumbs.db

# graphify — repo-local venv and generated knowledge graph. Recreate the venv with:
#   uv venv .graphify --python 3.12 && uv pip install --python .graphify/bin/python graphifyy
.graphify/
graphify-out/
.claude/settings.json.graphify-bak

# claude plugin eval writes run output here
.agents/skills/*/evals/results/

# Python bytecode from .agents/scripts/
__pycache__/
